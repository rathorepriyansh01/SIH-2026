# Backend environment variables
# Copy this file to .env in the project root and fill in your values.
# Never commit .env — it is in .gitignore.

# ── Required ────────────────────────────────────────────────────────────
# Groq API key for AI advisory generation
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Optional (defaults to SQLite for local dev) ─────────────────────────
# On Render, this is automatically set by the PostgreSQL add-on.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Override model file path (default: ml/models/best_crop_disease_model.pth)
MODEL_PATH=

# Comma-separated allowed frontend origins for CORS (default: * for local dev)
# Example: https://crop-health-ai.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=
"https://sih-2026-green-phi.vercel.app/"
